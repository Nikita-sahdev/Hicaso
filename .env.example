# Copy to .env.local on the server. All optional; the site runs without them.
NEXT_PUBLIC_SITE_URL=https://hicaso.com
# SMTP: the form emails each lead to hello@hicaso.com. Unset SMTP_HOST = leads are only saved to LEADS_FILE.
# Port 465 = TLS, 587 = STARTTLS. Gmail/Google Workspace: smtp.gmail.com, 465, and an app password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Must be an address SMTP_USER may send as (defaults to SMTP_USER)
ENQUIRY_FROM=Hicaso website <hello@hicaso.com>
# Where each lead is also saved, one JSON line per lead (outside the web root)
LEADS_FILE=/var/lib/hicaso/leads.jsonl
# Google Analytics 4 measurement ID (G-XXXXXXX); unset = no analytics
NEXT_PUBLIC_GA_ID=
